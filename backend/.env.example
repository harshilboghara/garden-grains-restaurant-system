# Database
MONGODB_URI=mongodb://localhost:27017/GardenGrains1

# JWT
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRE=7d

# Server
PORT=5000
NODE_ENV=development

# Gmail Configuration
GMAIL_USER=yourrestaurant@gmail.com
GMAIL_PASS=your-app-password

# Stripe (optional, card payments). The publishable key goes in frontend/.env
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# OpenAI (chatbot). If left empty the chatbot uses its rule-based fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=8000

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Initial admin account (used by createAdmin.js)
ADMIN_PASSWORD=choose-a-strong-password

# Inbox that receives password-reset codes for admin@gardengrains.com
# (leave empty to send them to the admin address itself)
ADMIN_RESET_EMAIL=
